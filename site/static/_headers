# Response headers for Cloudflare Pages. The build copies this file into
# public/ as it is; other hosts ignore it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Served as text so `irm https://solaria.sh/install.ps1 | iex` gets a string
# to run, and so a browser shows the scripts instead of downloading them.
# A short cache means a fixed script reaches people within minutes.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# The JSON Schemas, served at their $id URLs for editors (ADR 0015). Editors
# that run in a browser fetch them from another origin, so allow any. A short
# cache means a schema change on main reaches editors within minutes.
/schemas/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Keep the pages.dev copies and branch previews out of search results, so
# only solaria.sh is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
