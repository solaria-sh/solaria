{
  "binaries": [
    "npx"
  ],
  "pass": [
    "ALL_PROXY",
    "ANTHROPIC_API_KEY",
    "COMSPEC",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "NODE_EXTRA_CA_CERTS",
    "NO_PROXY",
    "NUMBER_OF_PROCESSORS",
    "OS",
    "PATHEXT",
    "PROCESSOR_ARCHITECTURE",
    "PROGRAMFILES",
    "REQUESTS_CA_BUNDLE",
    "SSL_CERT_DIR",
    "SSL_CERT_FILE",
    "SYSTEMDRIVE",
    "SYSTEMROOT",
    "TZ",
    "WINDIR",
    "all_proxy",
    "http_proxy",
    "https_proxy",
    "no_proxy"
  ],
  "secrets": [
    "MCP_TOKEN"
  ],
  "dotenv": "/project/secrets.env",
  "set": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "scratch": {
    "APPDATA": "home/AppData/Roaming",
    "CLAUDE_CONFIG_DIR": "home/.claude",
    "HOME": "home",
    "LOCALAPPDATA": "home/AppData/Local",
    "TEMP": "tmp",
    "TMP": "tmp",
    "TMPDIR": "tmp",
    "USERPROFILE": "home",
    "XDG_CACHE_HOME": "home/.cache",
    "XDG_CONFIG_HOME": "home/.config",
    "XDG_DATA_HOME": "home/.local/share",
    "XDG_STATE_HOME": "home/.local/state"
  },
  "cache": {
    "PIP_CACHE_DIR": "pip",
    "UV_CACHE_DIR": "uv",
    "npm_config_cache": "npm"
  }
}
