=== options.json
{
  "agent": {
    "logicalId": "Agent/reviewer",
    "environment": "dev-docker",
    "resolvedDigest": "sha256:7901953f1d4fb18e0c08e813c53e98e61bdb8f1e095baa6f5311235dccf53614"
  },
  "sdk": {
    "runtime": "node",
    "package": "@anthropic-ai/claude-agent-sdk",
    "version": "0.3.319"
  },
  "cacheDir": "/var/cache/solaria",
  "timeout": "15m0s",
  "timeoutMs": 900000,
  "systemPromptFile": "system-prompt.md",
  "options": {
    "model": "claude-sonnet-5-5",
    "fallbackModel": "claude-haiku-5-5",
    "effort": "high",
    "maxTurns": 40,
    "tools": [
      "Edit",
      "Grep",
      "Read",
      "Skill"
    ],
    "allowedTools": [
      "Edit",
      "Grep",
      "Read",
      "Skill",
      "mcp__docs__*",
      "mcp__github__get_pull_request"
    ],
    "disallowedTools": [
      "Bash",
      "mcp__github__create_issue"
    ],
    "permissionMode": "dontAsk",
    "settingSources": [],
    "strictMcpConfig": true,
    "mcpServers": {
      "docs": {
        "type": "http",
        "url": "https://docs.example.com/mcp",
        "headers": {
          "Authorization": {
            "secretRef": "DOCS_TOKEN"
          },
          "X-Team": "platform"
        }
      },
      "github": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github@2025.4.8",
          "--toolsets",
          "issues"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": {
            "secretRef": "GITHUB_TOKEN"
          }
        }
      }
    },
    "skills": [
      "reviewer:triage"
    ],
    "plugins": [
      {
        "type": "local",
        "path": "plugin"
      }
    ],
    "outputFormat": {
      "type": "json_schema",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "issue": {
            "format": "uri",
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "approve",
              "request-changes"
            ]
          }
        },
        "required": [
          "verdict",
          "summary"
        ],
        "type": "object"
      }
    }
  }
}
