=== Dockerfile
# syntax=docker/dockerfile:1
# Generated by Solaria for Agent/reviewer in environment dev-docker.
# Change the card or the environment and run solaria apply instead of editing it.

# The Solaria sandbox base: the cloud sandbox's OS and runtimes (ADR 0007).
FROM node:24.22.2-bookworm-slim AS node

FROM ubuntu:noble-20261024.1 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cargo curl git golang-go openjdk-21-jdk-headless \
      php-cli python3 python3-pip python3-venv ruby-full rustc unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && pip install --no-cache-dir --break-system-packages uv==0.13.7
ENV GOPATH=/opt/go GOBIN=/usr/local/bin CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH

# The environment's packages.
FROM base AS sandbox
RUN ["/bin/sh","-c","apt-get update && apt-get install -y --no-install-recommends \"$@\" && rm -rf /var/lib/apt/lists/*","apt","jq"]
RUN ["cargo","install","--locked","ripgrep@14.1.0"]

# The agent: the SDK at an exact version, then the bundle. Only the last
# layer changes when the card does.
FROM sandbox
WORKDIR /opt/solaria/agent
COPY package.json ./
RUN npm install --no-audit --no-fund --no-update-notifier --loglevel=error
COPY isolate.mjs isolation.json launch.mjs options.json system-prompt.md ./
COPY plugin/ ./plugin/
WORKDIR /workspace
ENTRYPOINT ["node","/opt/solaria/agent/launch.mjs"]
