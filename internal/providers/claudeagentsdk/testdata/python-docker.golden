=== Dockerfile
# syntax=docker/dockerfile:1
# Generated by Solaria for Agent/helper in environment ci-docker.
# Change the card or the environment and run solaria apply instead of editing it.

# The environment's own sandbox image.
FROM solaria/ci-docker/helper-sandbox:a54c06c78810 AS base

# The environment's packages.
FROM base AS sandbox

# The agent: the SDK at an exact version, then the bundle. Only the last
# layer changes when the card does.
FROM sandbox
WORKDIR /opt/solaria/agent
COPY requirements.txt ./
RUN python3 -m venv venv \
 && venv/bin/pip install --no-cache-dir --disable-pip-version-check --no-input -r requirements.txt \
 && venv/bin/pip freeze --disable-pip-version-check > requirements.lock
COPY isolate.py isolation.json launch.py options.json system-prompt.md ./
WORKDIR /workspace
ENTRYPOINT ["/opt/solaria/agent/venv/bin/python","/opt/solaria/agent/launch.py"]
