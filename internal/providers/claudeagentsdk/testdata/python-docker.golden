=== launch.py (shared)
=== options.json
{
  "agent": {
    "logicalId": "Agent/helper",
    "environment": "ci-docker",
    "resolvedDigest": "sha256:22656a684ef587a9e3a43f9272d21dec1121bac0a73d2eaa3aff57cbd34cd469"
  },
  "sdk": {
    "runtime": "python",
    "package": "claude-agent-sdk",
    "version": "0.2.178"
  },
  "cacheDir": "/var/cache/solaria",
  "systemPromptFile": "system-prompt.md",
  "options": {
    "model": "claude-haiku-5-5",
    "tools": [
      "Glob",
      "Read",
      "WebFetch"
    ],
    "allowedTools": [
      "Glob",
      "Read",
      "WebFetch",
      "mcp__notes__*"
    ],
    "disallowedTools": [],
    "permissionMode": "dontAsk",
    "settingSources": [],
    "strictMcpConfig": true,
    "mcpServers": {
      "notes": {
        "type": "stdio",
        "command": "uvx",
        "args": [
          "notes-mcp==0.4.1"
        ]
      }
    },
    "outputFormat": {
      "type": "json_schema",
      "schema": {
        "properties": {
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "type": "object"
      }
    }
  }
}
