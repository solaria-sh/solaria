=== options.json
{
  "agent": {
    "logicalId": "Agent/helper",
    "environment": "ci",
    "resolvedDigest": "sha256:f845570c2ebee00a9e5a275038b48a3513b9de9a79d25935867488735ffb3688"
  },
  "sdk": {
    "runtime": "python",
    "package": "claude-agent-sdk",
    "version": "0.2.170"
  },
  "cacheDir": "../../../.cache",
  "systemPromptFile": "system-prompt.md",
  "options": {
    "model": "claude-haiku-5-5",
    "tools": [
      "Glob",
      "Read",
      "WebFetch"
    ],
    "allowedTools": [
      "Glob",
      "Read",
      "WebFetch",
      "mcp__notes__*"
    ],
    "disallowedTools": [],
    "permissionMode": "dontAsk",
    "settingSources": [],
    "strictMcpConfig": true,
    "mcpServers": {
      "notes": {
        "type": "stdio",
        "command": "uvx",
        "args": [
          "notes-mcp==0.4.1"
        ]
      }
    }
  }
}
