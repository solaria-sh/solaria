=== srt-settings.json
{
  "network": {
    "allowedDomains": [
      "api.anthropic.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [],
    "allowWrite": [
      "/project/.solaria/claude-agent-sdk/.cache",
      "."
    ],
    "denyWrite": [
      "repositories/spec"
    ]
  }
}
