# syntax=docker/dockerfile:1
# Generated by Solaria: the Managed Agents self-hosted worker for Environment tools of target ma-self-hosted.

# The worker, cross-compiled on the build machine.
FROM --platform=$BUILDPLATFORM golang:1.27.3-bookworm AS worker
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum main.go ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /solaria-worker .

# The Solaria sandbox base: the cloud sandbox's OS and runtimes (ADR 0007).
FROM node:24.22.2-bookworm-slim AS node

FROM ubuntu:noble-20261024.1 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cargo curl git golang-go openjdk-21-jdk-headless \
      php-cli python3 python3-pip python3-venv ruby-full rustc unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && pip install --no-cache-dir --break-system-packages uv==0.13.7
ENV GOPATH=/opt/go GOBIN=/usr/local/bin CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH

# The target's packages.
FROM base AS sandbox
RUN ["/bin/sh","-c","apt-get update && apt-get install -y --no-install-recommends \"$@\" && rm -rf /var/lib/apt/lists/*","apt","jq"]

# Tools run in /workspace; memory stores mount under /mnt/memory.
FROM sandbox
COPY --from=worker /solaria-worker /usr/local/bin/solaria-worker
RUN mkdir -p /workspace /mnt/memory
WORKDIR /workspace
ENTRYPOINT ["solaria-worker"]
