=== Dockerfile
# syntax=docker/dockerfile:1
# Generated by Solaria for Agent/helper in environment dev.
# Change the card or the environment and run solaria apply instead of editing it.

# gitagent, built from a pinned commit on the build machine's own
# architecture and cross-compiled when the target differs.
FROM --platform=$BUILDPLATFORM rust:1.99.0-bookworm AS gitagent
ARG TARGETARCH
ARG GITAGENT_COMMIT=f4a309cd600b877177c17ac789e83bd7355d0383
RUN git init /src && cd /src \
 && git remote add origin https://github.com/open-gitagent/gitagent.git \
 && git fetch --depth 1 origin "$GITAGENT_COMMIT" && git checkout FETCH_HEAD
WORKDIR /src
RUN --mount=type=cache,target=/usr/local/cargo/registry set -eu; \
    case "$TARGETARCH" in amd64) arch=x86_64 ;; arm64) arch=aarch64 ;; *) echo "unsupported architecture $TARGETARCH" >&2; exit 1 ;; esac; \
    target="$arch-unknown-linux-gnu"; \
    if [ "$(uname -m)" != "$arch" ]; then \
      apt-get update && apt-get install -y --no-install-recommends "gcc-$(echo "$arch" | tr _ -)-linux-gnu" "libc6-dev-$TARGETARCH-cross"; \
      export "CARGO_TARGET_$(echo "$target" | tr a-z- A-Z_)_LINKER=$arch-linux-gnu-gcc" "CC_$(echo "$target" | tr - _)=$arch-linux-gnu-gcc"; \
    fi; \
    rustup target add "$target"; \
    cargo build --release --locked --target "$target" --bin gitagent; \
    cp "target/$target/release/gitagent" /usr/local/bin/gitagent

# The environment's own sandbox image.
FROM solaria/dev/helper-sandbox:f9014323ebe8 AS base

# The environment's packages.
FROM base AS sandbox

# The agent: gitagent and its config layer. Only these layers change when
# the card does.
FROM sandbox
COPY --from=gitagent /usr/local/bin/gitagent /usr/local/bin/gitagent
COPY home/ /root/
ENV HOME=/root
WORKDIR /workspace
ENTRYPOINT ["gitagent","--disallowed-tools","apply_patch,exec,memory,plan,str_replace,subagent,workflow,write_file,write_stdin"]
