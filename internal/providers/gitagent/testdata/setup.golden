=== setup.sh
#!/bin/sh
# Generated by Solaria for Agent/helper in target dev: runs its Environment's
# setup steps in the workspace, then gitagent (ADR 0022).
set -u

# clone
env -i "PATH=$PATH" "HOME=$HOME" REPO_URL=https://github.com/example/product.git "GH_TOKEN=$PRODUCT_TOKEN" sh -e -c 'git -c http.extraHeader="Authorization: Bearer $GH_TOKEN" clone --depth 1 "$REPO_URL" product' >&2 || {
  status=$?
  echo "solaria: setup step clone exited with $status" >&2
  exit 2
}

# note
env -i "PATH=$PATH" "HOME=$HOME" 'NOTE=it'\''s ready' sh -e -c 'echo "$NOTE" > note.txt' >&2 || {
  status=$?
  echo "solaria: setup step note exited with $status" >&2
  exit 2
}

unset PRODUCT_TOKEN
exec "$@"
