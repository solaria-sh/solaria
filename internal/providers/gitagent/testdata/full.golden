    - openai:gpt-6-astra
max_turns: 40
timeout_s: 900
skills: true
memory: false
learning: "off"
mcp_servers:
    docs:
        url: https://docs.example.com/mcp
        headers:
            Authorization: ${DOCS_TOKEN}
            X-Team: platform
    github:
        command: npx
        args:
            - -y
            - '@modelcontextprotocol/server-github@2025.4.8'
            - --toolsets
            - issues
        env:
            GITHUB_PERSONAL_ACCESS_TOKEN: ${GITHUB_TOKEN}
