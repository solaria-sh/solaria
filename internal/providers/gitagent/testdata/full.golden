# syntax=docker/dockerfile:1
# Generated by Solaria for Agent/reviewer in environment local-gitagent.
# Change the card or the environment and run solaria apply instead of editing it.

# gitagent, built from a pinned commit on the build machine's own
# architecture and cross-compiled when the target differs.
FROM --platform=$BUILDPLATFORM rust:1.99.0-bookworm AS gitagent
ARG TARGETARCH
ARG GITAGENT_COMMIT=0123456789abcdef0123456789abcdef01234567
RUN git init /src && cd /src \
 && git remote add origin https://github.com/open-gitagent/gitagent.git \
 && git fetch --depth 1 origin "$GITAGENT_COMMIT" && git checkout FETCH_HEAD
WORKDIR /src
RUN --mount=type=cache,target=/usr/local/cargo/registry set -eu; \
    case "$TARGETARCH" in amd64) arch=x86_64 ;; arm64) arch=aarch64 ;; *) echo "unsupported architecture $TARGETARCH" >&2; exit 1 ;; esac; \
    target="$arch-unknown-linux-gnu"; \
    if [ "$(uname -m)" != "$arch" ]; then \
      apt-get update && apt-get install -y --no-install-recommends "gcc-$(echo "$arch" | tr _ -)-linux-gnu" "libc6-dev-$TARGETARCH-cross"; \
      export "CARGO_TARGET_$(echo "$target" | tr a-z- A-Z_)_LINKER=$arch-linux-gnu-gcc" "CC_$(echo "$target" | tr - _)=$arch-linux-gnu-gcc"; \
    fi; \
    rustup target add "$target"; \
    cargo build --release --locked --target "$target" --bin gitagent; \
    cp "target/$target/release/gitagent" /usr/local/bin/gitagent

# The Solaria sandbox base: the cloud sandbox's OS and runtimes (ADR 0007).
FROM node:24.22.2-bookworm-slim AS node

FROM ubuntu:noble-20261024.1 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cargo curl git golang-go openjdk-21-jdk-headless \
      php-cli python3 python3-pip python3-venv ruby-full rustc unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && pip install --no-cache-dir --break-system-packages uv==0.13.7
ENV GOPATH=/opt/go GOBIN=/usr/local/bin CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH

# The environment's packages.
FROM base AS sandbox
RUN ["/bin/sh","-c","apt-get update && apt-get install -y --no-install-recommends \"$@\" && rm -rf /var/lib/apt/lists/*","apt","jq","ripgrep=14.1.0-1"]
RUN ["/bin/sh","-c","for m in \"$@\"; do go install \"$m\"; done","go","golang.org/x/tools/cmd/goimports@v0.30.0"]
RUN ["pip","install","--no-cache-dir","--break-system-packages","ruff==0.9.0"]

# The agent: gitagent and its config layer. Only these layers change when
# the card does.
FROM sandbox
COPY --from=gitagent /usr/local/bin/gitagent /usr/local/bin/gitagent
COPY home/ /root/
ENV HOME=/root
WORKDIR /workspace
ENTRYPOINT ["gitagent","--allowed-tools","apply_patch,docs__search,github__get_pull_request,image_read,read_file,skill,str_replace,todo"]
