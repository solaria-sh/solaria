# metadata.annotations record how an agent is operated (ADR 0008). They're
# left out of the digests and never sent to the host, so changing one
# plans nothing, and status -o json reads them from the configuration.
exec solaria apply -e local --auto-approve
stdout '^Apply complete: 1 created'

exec solaria status -e local -o json
stdout '"annotations": \{'
stdout '"owner": "platform-team"'
stdout '"trigger": "every pull request, after CI"'
stdout '"configuration": "upToDate"'

# Changing an annotation changes nothing deployed.
replace solaria.yaml 'owner: platform-team' 'owner: review-guild'
exec solaria plan -e local
stdout 'No changes'
exec solaria status -e local -o json
stdout '"owner": "review-guild"'
stdout '"configuration": "upToDate"'
! exec grep -r review-guild .solaria

# Keys follow the form of label keys.
replace solaria.yaml 'owner: review-guild' '"owner name": review-guild'
! exec solaria validate
stdout '^solaria.yaml:6:5: error: metadata.annotations: "owner name" is not a valid key: use letters, digits'

-- solaria.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata:
  name: reviewer
  annotations:
    owner: platform-team
    trigger: every pull request, after CI
spec:
  instructions: [role.md]
  model: {preferred: anthropic:claude-haiku-5-5}
---
apiVersion: solaria.sh/v1alpha1
kind: Environment
metadata: {name: local}
spec: {provider: stub, placement: file}
-- role.md --
Review.
