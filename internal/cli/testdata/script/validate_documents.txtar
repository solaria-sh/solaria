kind: Agent
metadata: {name: someone-elses}
-- keys.yaml --
apiVersion: solaria.sh/v1alpha1
kind: McpServer
metadata: {name: keys}
spec:
  remotes:
    - &remote {type: sse, url: "https://example.com/sse"}
  remotes:
    - *remote
---
apiVersion: solaria.sh/v1alpha1
kind: McpServer
metadata: {name: merge}
spec:
  <<: {description: merged}
  remotes: [{type: sse, url: "https://example.com/sse"}]
