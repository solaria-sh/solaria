# Checks across resources and files on disk.
! exec solaria validate
cmp stdout want.txt

-- want.txt --
agent.yaml:5:27: error: spec.instructions[1]: file "missing.md" not found
agent.yaml:5:39: error: spec.instructions[2]: "skills" is a directory, not a file
agent.yaml:11:15: error: spec.tools.mcp[1].ref: no McpServer named "nowhere"
agent.yaml:12:15: error: spec.tools.mcp[2].ref: McpServer "git-host" is referenced twice
agent.yaml:13:25: error: spec.skills[1]: skill folder "skills/missing" not found
agent.yaml:13:41: error: spec.skills[2]: skill folder "skills/no-skill-md" has no SKILL.md
agent.yaml:13:61: error: spec.skills[3]: skills/wrong-name/SKILL.md: name "other-name" must match the folder name "wrong-name"
agent.yaml:13:80: error: spec.skills[4]: skills/no-front-matter/SKILL.md has no YAML front matter
agent.yaml:13:104: error: spec.skills[5]: "role.md" is a file; a skill is a folder holding SKILL.md
agent.yaml:13:113: error: spec.skills[6]: skill "good" is also spec.skills[0]
agent.yaml:15:11: error: spec.permissions.ask[0]: "shell" is not in spec.tools.builtin
agent.yaml:15:18: error: spec.permissions.ask[1]: "add_comment" is not in the allowTools of "git-host"
agent.yaml:15:40: error: spec.permissions.ask[2]: "other/tool" names MCP server "other", which is not in spec.tools.mcp
agent.yaml:15:52: error: spec.permissions.ask[3]: "git-host/" has no tool name after the slash
agent.yaml:17:5: warning: spec.providers.managed-agents: fields for one provider make Agent/reviewer less portable
environments.yaml:8:15: warning: spec.agents.selector matches no agents
environments.yaml:9:32: error: spec.secrets.path only applies when source is dotenv
environments.yaml:11:12: error: spec.sandbox.image: file "./Dockerfile" not found
environments.yaml:12:42: warning: spec.sandbox.network.allow is ignored when mode is unrestricted
environments.yaml:14:5: warning: spec.overrides: Agent "reviewer" is not selected by spec.agents.selector, so this override has no effect
environments.yaml:16:9: warning: spec.overrides.reviewer.providers.gitagent: fields for one provider make Target/local less portable
environments.yaml:17:5: error: spec.overrides: no Agent named "ghost"
environments.yaml:33:3: error: spec: missing required field "model"
-- agent.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: reviewer}
spec:
  instructions: [role.md, missing.md, skills]
  model: {preferred: "anthropic:claude-sonnet-5-5"}
  tools:
    builtin: [read]
    mcp:
      - {ref: git-host, allowTools: [get_pull_request]}
      - {ref: nowhere}
      - {ref: git-host}
  skills: [skills/good, skills/missing, skills/no-skill-md, skills/wrong-name, skills/no-front-matter, role.md, other/good]
  permissions:
    ask: [shell, git-host/add_comment, other/tool, git-host/]
  providers:
    managed-agents: {inference_geo: us}
-- servers.yaml --
apiVersion: solaria.sh/v1alpha1
kind: McpServer
metadata: {name: git-host}
spec:
  remotes: [{type: streamable-http, url: "https://example.com/mcp"}]
-- environments.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: local}
spec:
  provider: gitagent
  placement: docker
  agents:
    selector: {matchLabels: {team: nobody}}
  secrets: {source: env, path: .env}
  sandbox:
    image: ./Dockerfile
    network: {mode: unrestricted, allow: [example.com]}
  overrides:
    reviewer:
      providers:
        gitagent: {profile: fast}
    ghost: {}
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: broken-target}
spec:
  provider: gitagent
  placement: docker
  overrides:
    # broken exists but fails the schema: only its own error is reported.
    broken: {}
---
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: broken}
spec:
  instructions: [role.md]
-- role.md --
Role.
