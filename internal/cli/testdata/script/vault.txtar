-- project/agents.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: reviewer}
spec:
  instructions: [role.md]
  model: {preferred: "anthropic:claude-sonnet-5-5"}
  tools:
    mcp: [{ref: git-host}]
  vaults: [{ref: git-host}]
---
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: loose}
spec:
  instructions: [role.md]
  model: {preferred: "anthropic:claude-sonnet-5-5"}
  tools:
    mcp: [{ref: git-host}]
---
apiVersion: solaria.sh/v1alpha1
kind: Vault
metadata: {name: git-host}
spec:
  credentials:
    - name: git-host-token
      secretRef: GIT_HOST_TOKEN
      for: {mcpServer: {ref: git-host}}
---
apiVersion: solaria.sh/v1alpha1
kind: McpServer
metadata: {name: git-host}
spec:
  remotes:
    - type: streamable-http
      url: https://git.example.com/mcp
      headers: [{name: Authorization, secretRef: GIT_HOST_TOKEN}]
---
apiVersion: solaria.sh/v1alpha1
kind: McpServer
metadata: {name: ticketing}
spec:
  packages:
    - registryType: npm
      identifier: "@example/ticketing-mcp"
      version: 2.0.0
      transport: {type: stdio}
      environmentVariables: [{name: TOKEN, secretRef: TICKET_TOKEN}]
-- project/role.md --
You review pull requests.
-- project/bad.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: bad}
spec:
  instructions: [role.md]
  model: {preferred: "anthropic:claude-sonnet-5-5"}
  tools:
    mcp: [{ref: git-host}, {ref: ticketing}]
  vaults: [{ref: git-host}, {ref: git-host}, {ref: nowhere}]
---
apiVersion: solaria.sh/v1alpha1
kind: Vault
metadata: {name: broken}
spec:
  credentials:
    - name: token
      secretRef: GIT_HOST_TOKEN
      for: {mcpServer: {ref: missing}}
    - name: token
      secretRef: OTHER_TOKEN
      for: {mcpServer: {ref: git-host}}
    - name: cli
      secretRef: CLI_TOKEN
      for: {env: CLI_TOKEN}
-- hosts/solaria.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: reviewer}
spec:
  instructions: [role.md]
  model: {preferred: "anthropic:claude-sonnet-5-5"}
  tools:
    mcp: [{ref: git-host}]
  vaults: [{ref: git-host}]
---
apiVersion: solaria.sh/v1alpha1
kind: Vault
metadata: {name: git-host}
spec:
  credentials:
    - name: git-host-token
      secretRef: GIT_HOST_TOKEN
      for: {mcpServer: {ref: git-host}}
    - name: gh-cli
      secretRef: GITHUB_PAT
      for: {env: GH_TOKEN}
---
apiVersion: solaria.sh/v1alpha1
kind: McpServer
metadata: {name: git-host}
spec:
  remotes:
    - type: streamable-http
      url: https://git.example.com/mcp
      headers: [{name: Authorization, secretRef: GIT_HOST_TOKEN}]
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: local-gitagent}
spec:
  provider: gitagent
  placement: docker
  secrets: {source: dotenv, path: .env}
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: ma-cloud}
spec:
  provider: managed-agents
  placement: cloud
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: sdk-docker}
spec:
  provider: claude-agent-sdk
  placement: docker
-- hosts/role.md --
You review pull requests.
