# status -a shows how to start an agent, from the invocation its provider
# recorded at apply (ADR 0014). The states are written by hand: applying
# needs npm or Docker.
cp $EXAMPLES/hello/solaria.yaml $EXAMPLES/hello/instructions.md .
mkdir .solaria/state
cp local-sdk.json .solaria/state/local-sdk.json
cp local-gitagent.json .solaria/state/local-gitagent.json

# Without -a, the table alone.
exec solaria status
stdout '^Target local-gitagent \(state serial 4\)$'
stdout '^  Agent/hello +claude-agent-sdk/process +\.solaria/claude-agent-sdk/local-sdk/hello +3f9c1a0d2b7e +sha256:08ffaed7b158 +2026-11-01 10:00 +up to date$'
! stdout 'run:'

exec solaria status -t local-sdk -a hello
cmp stdout status-sdk.txt
exec solaria status -t local-sdk -a hello -o json
cmp stdout status-sdk.json

# An entry applied before Solaria recorded invocations, or the runtime,
# still has its run command.
exec solaria status -t local-gitagent -a hello
! stdout 'runtime:'
stdout '^  run: docker run --rm --platform linux/amd64 --memory 8g --volume "\$PWD":/workspace --env ANTHROPIC_API_KEY solaria/local-gitagent/hello:08ffaed7b158$'
stdout '^  Applied before Solaria recorded what the command needs; apply again to see it.$'

# An agent the configuration selects but nothing applied yet.
exec solaria status -t ma-cloud -a hello
stdout '^  Agent/hello +- +- +- +- +- +not applied$'
stdout '^  Not applied; run solaria apply -t ma-cloud first.$'

-- status-sdk.txt --
Target local-sdk (state serial 2)
  OBJECT       PROVIDER                  HOST ID                                    VERSION       DIGEST               APPLIED           CONFIGURATION
  Agent/hello  claude-agent-sdk/process  .solaria/claude-agent-sdk/local-sdk/hello  3f9c1a0d2b7e  sha256:08ffaed7b158  2026-11-01 10:00  up to date

  runtime: @anthropic-ai/claude-agent-sdk@0.3.319
  run: node '/work/my project/.solaria/claude-agent-sdk/local-sdk/hello/3f9c1a0d2b7e/launch.mjs'
  task: after the command with -p, or on stdin
  workspace: the directory it runs in
  environment: ANTHROPIC_API_KEY, GITHUB_TOKEN
  prints: solaria.sh/result/v1
