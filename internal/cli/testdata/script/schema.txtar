# The combined schema dispatches on kind.
exec solaria schema
stdout '"\$id": "https://solaria.sh/schemas/v1alpha1/solaria.json"'
stdout '"\$ref": "#/\$defs/Agent"'

# A kind's own schema, by any capitalization.
exec solaria schema mcpserver
stdout '"\$id": "https://solaria.sh/schemas/v1alpha1/mcpserver.json"'

! exec solaria schema robot
stderr '^Error: unknown kind "robot"; solaria.sh/v1alpha1 has Agent, Target, McpServer, Vault$'

! exec solaria schema agent extra
stderr 'accepts at most 1 arg'
