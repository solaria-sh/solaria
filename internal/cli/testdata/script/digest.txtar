-- solaria.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata:
  name: triage
  labels: {stage: prod}
spec:
  instructions: [triage.md]
  model: {preferred: anthropic:claude-haiku-5-5}
---
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata:
  name: helper
spec:
  instructions: [triage.md]
  model: {preferred: anthropic:claude-sonnet-5-5}
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata:
  name: dev
spec:
  provider: stub
  placement: file
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata:
  name: prod
spec:
  provider: stub
  placement: file
  agents:
    selector:
      matchLabels: {stage: prod}
  overrides:
    triage: {limits: {maxTurns: 2}}
-- triage.md --
Sort incoming issues.
