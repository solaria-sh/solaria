# solaria digest reads only the configuration: no state, no host.

# Without -t: every agent's specDigest.
exec solaria digest
cmp stdout all.txt
! stderr .
! exists .solaria

# With -t: only the agents the target selects, with resolvedDigest.
# The override changes triage's resolvedDigest, not its specDigest.
exec solaria digest -t prod
cmp stdout prod.txt
exec solaria digest -t dev -o json
cmp stdout dev.json

# -a picks agents, and can be repeated.
exec solaria digest -a triage -a helper
cmp stdout all.txt
exec solaria digest -t dev -a helper
cmp stdout dev-helper.txt

# Unknown agents, agents the target leaves out, unknown targets.
! exec solaria digest -a nope
stderr '^Error: no Agent named "nope"$'
! exec solaria digest -t prod -a helper
stderr '^Error: agent "helper" isn''t selected by Target "prod"; its agents.selector leaves it out$'
! exec solaria digest -t nope
stderr '^Error: no Target named "nope"$'
! exec solaria digest -o yaml
stderr '^Error: --output must be text or json, not "yaml"$'

# A change to an instruction file changes both digests.
exec solaria digest -a triage
cp stdout before.txt
replace triage.md 'Sort' 'Label'
exec solaria digest -a triage
! cmp stdout before.txt

