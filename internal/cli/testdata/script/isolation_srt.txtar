# sandbox.isolation: srt wraps process runs in Anthropic's sandbox-runtime
# (ADR 0017). A container placement runs in a sandbox of its own, so it
# refuses the setting.
cd docker
! exec solaria plan -t sdk-docker
stderr '^solaria.yaml: error: Environment "sdk-docker" for Agent/hello on claude-agent-sdk/docker: spec.isolation srt isn''t supported here; it wraps runs on the process placement, and other placements run in a sandbox of their own \(ADR 0017\)$'
! stdout .

# On process, planning checks that this machine can run srt, and that the
# network stays limited: srt has no way to allow every host.
[!exec:node] skip 'the process placement checks for node'
[windows] skip 'srt doesn''t run on Windows'
[exec:srt] skip 'this machine has srt; the check needs one without it'
cd ../process
! exec solaria plan -t local-srt
stderr '^solaria.yaml: error: Agent/hello on claude-agent-sdk/process: its Environment''s spec.isolation srt can''t isolate runs on this machine: srt isn''t on PATH; install it with npm install -g @anthropic-ai/sandbox-runtime$'
stderr '^solaria.yaml: error: Agent/hello on claude-agent-sdk/process: its Environment''s spec.isolation srt limits the network to the hosts the agent needs, so it can''t be combined with spec.network.mode unrestricted; list the extra hosts in spec.network.allow$'
! stderr 'network is limited'
! stdout .
! exists .solaria/claude-agent-sdk

-- docker/instructions.md --
Say hello.
-- docker/solaria.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: hello}
spec:
  instructions: [instructions.md]
  model: {preferred: anthropic:claude-haiku-5-5}
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: sdk-docker}
spec:
  provider: claude-agent-sdk
  placement: docker
  environments: [{ref: sdk-docker}]
---
apiVersion: solaria.sh/v1alpha1
kind: Environment
metadata: {name: sdk-docker}
spec: {isolation: srt}
-- process/instructions.md --
Say hello.
-- process/solaria.yaml --
apiVersion: solaria.sh/v1alpha1
kind: Agent
metadata: {name: hello}
spec:
  instructions: [instructions.md]
  model: {preferred: anthropic:claude-haiku-5-5}
---
apiVersion: solaria.sh/v1alpha1
kind: Target
metadata: {name: local-srt}
spec:
  provider: claude-agent-sdk
  placement: process
  environments: [{ref: local-srt}]
---
apiVersion: solaria.sh/v1alpha1
kind: Environment
metadata: {name: local-srt}
spec:
  isolation: srt
  network: {mode: unrestricted}
