          "resolvedDigest": "sha256:08ffaed7b158236f52eb743bb34362fe8fc394e6c9399cf06e771fb2d26ffe2f",
          "appliedAt": "2026-11-01T10:00:00Z",
          "configuration": "upToDate",
          "environment": {
            "name": "default",
            "hostId": "env_01"
          }
        }
      ]
    }
  ]
}
