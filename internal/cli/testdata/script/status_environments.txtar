# status lists each Environment's host object and the agents it's for, and
# -a gives the environment ID to start an agent's sessions in (ADR 0020).
# The state is written by hand, the way Solaria wrote it before ADR 0020:
# one host object, under host, which belongs to the target's default
# Environment, here the built-in sandbox.
cp $EXAMPLES/hello/solaria.yaml $EXAMPLES/hello/instructions.md .
mkdir .solaria/state
cp ma-cloud.json .solaria/state/ma-cloud.json

exec solaria status -t ma-cloud
cmp stdout status.txt
exec solaria status -t ma-cloud -a hello
stdout '^  environment: start sessions in env_01 \(Environment default\)$'
exec solaria status -t ma-cloud -a hello -o json
cmp stdout status.json

-- status.txt --
Target ma-cloud (state serial 3)
  OBJECT               PROVIDER              HOST ID   VERSION  DIGEST               APPLIED           CONFIGURATION
  Environment/default  managed-agents/cloud  env_01    -        sha256:111111111111  2026-11-01 10:00  for Agent/hello
  Agent/hello          managed-agents/cloud  agent_01  1        sha256:08ffaed7b158  2026-11-01 10:00  up to date
-- status.json --
{
  "targets": [
