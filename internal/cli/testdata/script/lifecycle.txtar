# The full cycle on examples/hello with the stub provider.
cp $EXAMPLES/hello/solaria.yaml $EXAMPLES/hello/instructions.md .
exec solaria validate
stdout '^valid: 1 Agent, 2 Environments$'

# A first plan creates the agent and changes nothing.
exec solaria plan -e local
cmp stdout plan-create.txt
! exists .solaria/state/local.json
! exec solaria plan -e local --detailed-exitcode
! stderr .

# Apply records the agent at serial 1.
exec solaria apply -e local --auto-approve
stdout '^Apply complete: 1 created, 0 updated, 0 replaced, 0 deleted. State serial 1.$'
stdout '^  Agent/hello: stub_[0-9a-f]{12} version 1 \(sha256:08ffaed7b158\)$'
grep '"serial": 1' .solaria/state/local.json
grep '"specDigest": "sha256:08ffaed7b158' .solaria/state/local.json
exists .solaria/stub/local/hello.json
exists .solaria/.gitignore

# Nothing changed, so nothing to do.
exec solaria plan -e local --detailed-exitcode
cmp stdout plan-none.txt
exec solaria status
stdout '^  Agent/hello +stub/file +stub_[0-9a-f]{12} +1 +sha256:08ffaed7b158 +\S+ \S+ +up to date$'

# An override changes only this environment: resolvedDigest moves,
# specDigest stays.
replace solaria.yaml '  placement: file' '  placement: file\n  overrides:\n    hello: {limits: {maxTurns: 2}}'
exec solaria status
stdout 'overrides changed$'
! exec solaria plan -e local --detailed-exitcode
cmp stdout plan-override.txt

# Editing the instructions changes the agent itself.
replace instructions.md 'one short sentence' 'two short sentences'
exec solaria plan -e local
cmp stdout plan-instructions.txt

# Apply asks first; anything but yes cancels.
stdin no.txt
! exec solaria apply -e local
stderr '^Error: apply cancelled$'
grep '"serial": 1' .solaria/state/local.json
stdin yes.txt
exec solaria apply -e local
stdout 'Apply complete: 0 created, 1 updated, 0 replaced, 0 deleted. State serial 2.'
stdout 'version 2'
grep '"history"' .solaria/state/local.json

# Destroy removes the host object and empties the state.
stdin yes.txt
exec solaria destroy -e local
stdout '^  - Agent/hello$'
stdout 'Destroy complete: 0 created, 0 updated, 0 replaced, 1 deleted. State serial 3.'
! exists .solaria/stub/local/hello.json
exec solaria status -o json
stdout '"agents": \{\}'
exec solaria plan -e local
stdout '\+ Agent/hello'

-- yes.txt --
yes
-- no.txt --
no
-- plan-create.txt --
Environment local (stub/file)

  + Agent/hello
      resolvedDigest: sha256:08ffaed7b158

Plan: 1 to create, 0 to update, 0 to replace, 0 to delete.
-- plan-none.txt --
Environment local (stub/file)

No changes. The environment matches the configuration.
-- plan-override.txt --
Environment local (stub/file)

  ~ Agent/hello
      ~ limits.maxTurns: 5 -> 2
      resolvedDigest: sha256:08ffaed7b158 -> sha256:627f9817d8d8 (specDigest unchanged: only this environment's overrides differ)

Plan: 0 to create, 1 to update, 0 to replace, 0 to delete.
-- plan-instructions.txt --
Environment local (stub/file)

  ~ Agent/hello
      ~ instructions[0]: text changed (1 line -> 1 line)
      ~ limits.maxTurns: 5 -> 2
      resolvedDigest: sha256:08ffaed7b158 -> sha256:c98d0aad9727

Plan: 0 to create, 1 to update, 0 to replace, 0 to delete.
